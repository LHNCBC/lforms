{
  "resourceType": "Questionnaire",
  "meta": {
    "profile": [
      "http://hl7.org/fhir/4.0/StructureDefinition/Questionnaire"
    ]
  },
  "title": "Multi-select with child items controlled by calculated values",
  "status": "draft",
  "item": [
    {
      "linkId": "number",
      "text": "Number (more than 5 shows the Case 1 follow-up questions)",
      "type": "integer"
    },
    {
      "linkId": "number-more-than-5",
      "text": "Number is more than 5 (calculated)",
      "type": "boolean",
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%resource.item.where(linkId='number').answer.value > 5"
          }
        }
      ]
    },
    {
      "linkId": "case1-calculated-other",
      "text": "Case 1: only child is enabled by a calculated value that depends on another question",
      "type": "choice",
      "repeats": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://hl7.org/fhir/questionnaire-item-control",
                "code": "check-box"
              }
            ]
          }
        }
      ],
      "answerOption": [
        { "valueCoding": { "code": "a", "display": "Apple" } },
        { "valueCoding": { "code": "b", "display": "Banana" } }
      ],
      "item": [
        {
          "linkId": "case1-child",
          "text": "How many? (enabled when the number is more than 5)",
          "type": "integer",
          "enableWhen": [
            {
              "question": "number-more-than-5",
              "operator": "=",
              "answerBoolean": true
            }
          ]
        }
      ]
    },
    {
      "linkId": "case2-apple-selected",
      "text": "Case 2 includes Apple (calculated)",
      "type": "boolean",
      "extension": [
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "language": "text/fhirpath",
            "expression": "%resource.item.where(linkId='case2-calculated-parent').answer.value.where(code = 'a').exists()"
          }
        }
      ]
    },
    {
      "linkId": "case2-calculated-parent",
      "text": "Case 2: only child is enabled by a calculated value that is true when the parent includes Apple",
      "type": "choice",
      "repeats": true,
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://hl7.org/fhir/questionnaire-item-control",
                "code": "check-box"
              }
            ]
          }
        }
      ],
      "answerOption": [
        { "valueCoding": { "code": "a", "display": "Apple" } },
        { "valueCoding": { "code": "b", "display": "Banana" } }
      ],
      "item": [
        {
          "linkId": "case2-child",
          "text": "Variety (enabled when Apple is selected)",
          "type": "string",
          "enableWhen": [
            {
              "question": "case2-apple-selected",
              "operator": "=",
              "answerBoolean": true
            }
          ]
        }
      ]
    }
  ]
}
